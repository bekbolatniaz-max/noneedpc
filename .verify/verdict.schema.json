{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Codex verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "criteria", "issues", "contract_violations", "missing_tests"],
  "properties": {
    "verdict": { "type": "string", "enum": ["PASS", "FAIL"] },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "unverifiable"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "description"],
        "properties": {
          "severity": { "type": "string", "enum": ["blocker", "major", "minor"] },
          "file": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "contract_violations": { "type": "array", "items": { "type": "string" } },
    "missing_tests": { "type": "array", "items": { "type": "string" } }
  }
}
